{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": ["node"]
  },
  "include": [
    "app/assessment-app.tsx",
    "app/api/**/*.ts",
    "app/globals.css",
    "components/**/*.tsx",
    "db/**/*.ts",
    "github-src/**/*.ts",
    "github-src/**/*.tsx",
    "lib/candidate-report.ts",
    "lib/client-types.ts",
    "lib/expanded-role-questions.ts",
    "lib/question-bank.ts",
    "lib/scoring.ts",
    "vite.github.config.ts"
  ],
  "exclude": ["node_modules", "app/api", "db", "build", "scripts", "vite.config.ts"]
}
